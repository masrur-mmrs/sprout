# Copy to backend/.env for local development. Production values come from Cloud Run
# env vars and Secret Manager, never from a file.

NODE_ENV=development
PORT=8080

# Matches docker-compose.yml. Change the port if you set POSTGRES_PORT.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sprout_dev

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Origin of the Next.js frontend (used for reset links and the Origin check).
APP_URL=http://localhost:3000

# https://resend.com/api-keys. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Sprout <no-reply@example.com>"

GCS_BINARY_BUCKET=sprout-binaries-dev
GCS_ICON_BUCKET=sprout-icons-dev

# Proxy hops in front of Express. Locally the Next.js /api rewrite is one hop. Production is
# not 1: Vercel's edge plus Google's front end is likely 2. Confirm on the first deploy that
# req.ip is the browser's IP. Too low puts every user in one rate-limit bucket.
TRUST_PROXY_HOPS=1
